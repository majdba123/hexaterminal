APP_NAME="Hexa Terminal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Initial admin account (used by UsersTableSeeder only) ──
# REQUIRED to seed the admin user. No defaults exist on purpose.
# Password must be at least 12 characters.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hexa_terminal
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Lead notifications (safe disabled when empty; Company Settings in the
#    CMS take precedence over this env fallback) ──
LEAD_NOTIFICATION_RECIPIENTS=

# ── Optional anti-spam for lead/newsletter forms. Skipped entirely (honeypot
#    + throttle still apply) when no secret is set. ──
TURNSTILE_SECRET_KEY=

# ── AI SEO assistant (App\Services\AiSeo). Disabled -- reports itself
#    unavailable, never fakes output -- unless ANTHROPIC_API_KEY is set. ──
AI_SEO_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_SEO_MODEL=claude-opus-4-8
AI_SEO_TIMEOUT=30

# ── Legacy surface isolation (config/legacy.php) ──
# Fail-closed: every legacy surface is DISABLED unless set truthy. Enable only
# for local compatibility work. NEVER enable in staging/production. See
# docs/security/legacy-security-baseline.md.
LEGACY_PUBLIC_WEB_ENABLED=false
LEGACY_ADMIN_ENABLED=false
LEGACY_API_ENABLED=false

# ── Security headers (config/security.php) ──
# CSP ships Report-Only by default (Filament/Alpine needs 'unsafe-eval');
# flip CSP_ENFORCE=true only per docs/security/content-security-policy.md.
CSP_ENABLED=true
CSP_ENFORCE=false
# HSTS is emitted only on secure production requests, and only when enabled.
HSTS_ENABLED=false
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# ── Session cookie security (must be true in production) ──
SESSION_SECURE_COOKIE=false

VITE_APP_NAME="${APP_NAME}"

# `php artisan serve` runs a SINGLE worker by default, which self-deadlocks this
# app: the Next.js route handlers (/api/estimates, /api/leads) call this API
# while it is already busy serving the page that triggered them, so nothing is
# free to answer and the request times out. Laravel only honours this variable
# when `serve` is also given `--no-reload` (see .claude/launch.json), otherwise
# it prints a warning and stays single-worker.
PHP_CLI_SERVER_WORKERS=8
