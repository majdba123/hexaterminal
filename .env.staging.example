# =============================================================================
# Hexa Terminal — Laravel backend — STAGING example
# Copy to `.env` on the staging server and fill in real values. NEVER commit a
# filled-in .env. All secrets below are placeholders.
# =============================================================================

APP_NAME="Hexa Terminal (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false                            # MUST be false outside local
APP_URL=https://api-staging.hexaterminal.com
# Optional explicit public media/API origin for absolute CMS file URLs.
# Set this when APP_URL is reserved for internal/container routing.
PUBLIC_MEDIA_URL=https://api-staging.hexaterminal.com
APP_VERSION=                               # set to the deploy commit SHA in CI/CD

# Public frontend origin (Next.js). Used for CORS + links.
FRONTEND_URL=https://staging.hexaterminal.com

# ── Initial admin account (UsersTableSeeder only; run once) ──
ADMIN_NAME="Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Logging ──
LOG_CHANNEL=stack
LOG_LEVEL=info                             # info in staging (debug leaks detail)
LOG_DEPRECATIONS_CHANNEL=null

# ── Database (use a DEDICATED staging DB; never point at production) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hexa_terminal_staging
DB_USERNAME=hexa_staging
DB_PASSWORD=

# ── Cache / queue / session ──
CACHE_DRIVER=redis                         # file works too; redis recommended
FILESYSTEM_DISK=public                     # served media lives on the public disk
QUEUE_CONNECTION=redis                     # sync is fine if no worker is running
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Session cookie hardening (HTTPS staging). SESSION_DOMAIN scopes the CMS
# session cookie to the API host; keep it host-specific, not a wildcard, unless
# the CMS and frontend truly share a parent domain and you need SSO.
SESSION_DOMAIN=api-staging.hexaterminal.com
SESSION_SECURE_COOKIE=true

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Trusted proxies (behind Nginx / a load balancer terminating TLS) ──
# "*" trusts the immediate upstream; pin to the LB IP/CIDR where possible.
TRUSTED_PROXIES=*

# ── Legacy surface isolation (config/legacy.php). MUST stay disabled in
#    staging/production so no duplicate public/admin/API surface is exposed. ──
LEGACY_PUBLIC_WEB_ENABLED=false
LEGACY_ADMIN_ENABLED=false
LEGACY_API_ENABLED=false

# ── Security headers (config/security.php). CSP is Report-Only until the
#    enforce blockers in docs/security/content-security-policy.md clear.
#    HSTS is safe here because staging is HTTPS-only. ──
CSP_ENABLED=true
CSP_ENFORCE=false
HSTS_ENABLED=true
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# ── CORS: explicit allow-list of browser origins. NEVER "*" in staging. ──
CORS_ALLOWED_ORIGINS=https://staging.hexaterminal.com
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=600

# ── Sanctum (only needed if the frontend uses cookie/stateful auth; the public
#    read API and token auth do not). Set to the frontend host if you enable it. ──
SANCTUM_STATEFUL_DOMAINS=staging.hexaterminal.com

# ── On-demand frontend revalidation (see config/revalidation.php) ──
# Must match the frontend's REVALIDATE_SECRET exactly. Generate a long random
# value: `php artisan tinker --execute="echo bin2hex(random_bytes(32));"`.
REVALIDATION_ENABLED=true
REVALIDATION_URL=https://staging.hexaterminal.com/api/revalidate
REVALIDATION_SECRET=
REVALIDATION_TIMEOUT=3

# ── Mail ──
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@hexaterminal.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Lead notifications (safe disabled when empty) ──
LEAD_NOTIFICATION_RECIPIENTS=

# ── Optional anti-spam for public forms (skipped, not open, when empty) ──
TURNSTILE_SECRET_KEY=

# ── AI SEO assistant -- disabled (reports itself unavailable) unless set ──
AI_SEO_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_SEO_MODEL=claude-opus-4-8
AI_SEO_TIMEOUT=30
