# =============================================================================
# Hexa Terminal — Next.js frontend — STAGING example
# Copy to `.env` (or set in the platform's env UI) for the staging deploy.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time — put
# ONLY non-secret values there. Everything else is server-only.
# =============================================================================

# ── Server-only: where the frontend reaches the Laravel API. Not exposed to
#    the browser. Prefer the internal/private address if the API is reachable
#    over a private network from the Next.js server. ──
API_URL=https://api-staging.hexaterminal.com/api/v1/public

# ── Public: the canonical site origin. Used for canonicals, OG URLs, sitemap. ──
NEXT_PUBLIC_SITE_URL=https://staging.hexaterminal.com

# ── Indexing kill-switch. MUST be "false" (or absent) on staging so robots,
#    page metadata, and the X-Robots-Tag header all resolve to noindex.
#    Only production sets this to "true". ──
NEXT_PUBLIC_ALLOW_INDEXING=false

# ── Server-only: on-demand revalidation secret. Must equal the Laravel
#    REVALIDATION_SECRET. Never prefix with NEXT_PUBLIC_ (that would leak it to
#    the browser). Generate: `openssl rand -hex 32`. ──
REVALIDATE_SECRET=

# ── Optional: deploy commit SHA, surfaced by /api/health. ──
APP_VERSION=

# ── Analytics boundary: leave both empty to disable entirely. On staging,
#    typically leave disabled -- there is no reason to collect analytics on a
#    noindex, internal-only environment. See components/site/analytics-script.tsx. ──
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
