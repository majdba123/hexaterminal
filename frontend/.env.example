API_URL=http://localhost:8000/api/v1/public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only on the real production deployment. Everywhere else
# (local dev, staging, preview deploys) robots.ts serves a disallow-all
# policy so search engines never index a non-production copy of the site.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Server-only secret for the on-demand revalidation endpoint (/api/revalidate).
# Must match the Laravel REVALIDATION_SECRET. Leave empty to disable locally.
# NEVER prefix with NEXT_PUBLIC_ (that would leak it to the browser bundle).
REVALIDATE_SECRET=

# Analytics boundary: leave both empty to disable analytics entirely (no
# fake data, no third-party request). Set exactly one provider at a time --
# never both.
#   plausible: NEXT_PUBLIC_ANALYTICS_PROVIDER=plausible
#              NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#              NEXT_PUBLIC_ANALYTICS_DOMAIN=hexaterminal.com
#   umami:     NEXT_PUBLIC_ANALYTICS_PROVIDER=umami
#              NEXT_PUBLIC_ANALYTICS_SRC=https://umami.example.com/script.js
#              NEXT_PUBLIC_ANALYTICS_SITE_ID=<your-site-id>
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
