    "concurrency": {
      "group": "hexaterminal-production-deploy",
      "cancel_in_progress": false
    },
    "jobs": {
      "validate": {
        "runs_on": "ubuntu-latest",
        "timeout_minutes": 35,
        "php_setup": "shivammathur/setup-php@v2",
        "php_version": "8.3",
        "node_setup": "actions/setup-node@v4",
        "node_version": "22",
        "laravel_validation_commands": [
          "composer install --prefer-dist --no-interaction",
          "npm install --include=optional",
          "npx vite build",
          "php artisan migrate --force",
          "php artisan db:seed --force",
          "php artisan hexa:migrate-legacy-content",
          "php artisan test tests/Feature/HealthTest.php tests/Feature/Api/V1 tests/Feature/Security/CorsPolicyTest.php tests/Feature/Security/ErrorLeakageTest.php tests/Feature/Security/FilamentAuthorizationTest.php tests/Feature/Security/FilamentMfaTest.php tests/Feature/Security/RateLimitingTest.php tests/Feature/Security/ReplayAndAbuseTest.php tests/Feature/Security/ReviewModerationTest.php tests/Feature/Security/SecurityHeadersTest.php tests/Feature/Security/SlugValidationTest.php tests/Feature/Security/StorageRouteTest.php tests/Feature/Security/UploadAllowlistTest.php tests/Feature/Pricing tests/Feature/RevalidationTest.php"
        ],
        "frontend_validation_commands": [
          "npm install --include=optional",
          "php artisan serve --host=127.0.0.1 --port=8000",
          "npm run typecheck",
          "npm run lint -- .",
          "npm run build"
        ]
      },
      "deploy": {
        "needs": [
          "validate"
        ],
        "ssh_action": "appleboy/ssh-action@v1.2.0",
        "production_directory": "/var/www/hexaterminal",
        "frontend_directory": "/var/www/hexaterminal/frontend",
        "composer_command": "composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction",
        "frontend_commands": [
          "npm install --include=optional",
          "npm run typecheck",
          "npm run lint -- .",
          "npm run build"
        ],
        "migration_command": "php artisan migrate --force",
        "optimization_commands": [
          "php artisan optimize:clear",
          "php artisan optimize"
        ],
        "queue_restart": "php artisan queue:restart",
        "frontend_restart": "systemctl restart hexa-frontend",
        "frontend_active_check": "systemctl is-active --quiet hexa-frontend",
        "nginx_validation": "nginx -t",
        "nginx_reload": "systemctl reload nginx",
        "backend_health_url": "https://api.hexaterminal.com/api/health/ready",
        "frontend_health_url": "https://hexaterminal.com/api/health",
        "public_page_url": "https://hexaterminal.com/en"
      }
    }
