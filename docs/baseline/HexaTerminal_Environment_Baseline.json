  "deployment": {
    "workflow_path": ".github/workflows/deploy-production.yml",
    "workflow_name": "Deploy Production",
    "triggers": {
      "push_branches": [
        "main"
      ],
      "workflow_dispatch": true
    },
    "permissions": {
      "contents": "read"
